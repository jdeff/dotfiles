# Template for ~/.config/dev/workspace.toml  (NOT tracked — this repo is public).
#
# The identity / org / team map agents resolve a ticket key through. Repos are
# not listed here; a team names its muster project and `muster projects --json`
# resolves it. See dev/README.md.
#
# install.sh seeds ~/.config/dev/workspace.toml from this template if it's missing.

[me]
github_handle = "your-github-handle"   # one GitHub identity; Linear's is per workspace

[defaults]
# Branch names are built from this rather than Linear's gitBranchName. A team may
# override it. A second PR in the same repo adds a suffix: user/wid-136-2.
branch_pattern = "{linear_user}/{linear_key_lower}-{number}"

# `linear_workspace` is the slug from a Linear issue URL (linear.app/<slug>/issue/…).
# `linear_mcp` is the MCP server bound to that workspace — one connection serves one
# workspace, so each org needs its own. See dev/README.md for the setup.
# `linear_user` is per workspace: the same person has a different username in each,
# and it leads the branch name Linear generates.

[orgs.acme]
name             = "Acme Inc"
linear_workspace = "acme"
linear_mcp       = "linear-acme"
linear_user      = "your-username-in-that-workspace"

[teams.widgets]
linear_key     = "WID"        # the ticket prefix, e.g. WID-136
linear_name    = "Widgets"
org            = "acme"
muster_project = "acme-app"   # must match a project in muster's config
default_repo   = "acme-api"   # where a ticket starts when it names no repo
# Optional: request review from this team. Whether it round-robins to one person is
# a GitHub team setting (Team → Settings → Code review assignment). Omit for solo repos.
github_team    = "acme/widgets"
