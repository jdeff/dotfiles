#!/usr/bin/env bash
# Add a worktree for a branch under $SOURCE/.worktrees/<repo>/<branch-slug> and
# copy the repo's untracked files into it (worktree-copy-files). Git only:
# opening a session for it is the caller's job.
#
# Usage: worktree-create --cwd <repo> --branch <name> [--base <ref>]
# An existing branch is checked out; a new one starts from --base (HEAD).
# Prints the worktree's path.

set -euo pipefail

cwd="" branch="" base=HEAD
while [ $# -gt 0 ]; do
  case "$1" in
    --cwd) cwd=$2; shift 2 ;;
    --branch) branch=$2; shift 2 ;;
    --base) base=$2; shift 2 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done
if [ -z "$cwd" ] || [ -z "$branch" ]; then
  echo "usage: $0 --cwd <repo> --branch <name> [--base <ref>]" >&2
  exit 2
fi

common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir)
main=${common%/.git}
slug=$(printf '%s' "$branch" | sed -E 's/[^A-Za-z0-9._-]+/-/g; s/^-+|-+$//g')
path="${SOURCE:-$HOME/src}/.worktrees/$(basename "$main")/$slug"

if git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
  git -C "$main" worktree add "$path" "$branch" >&2
else
  git -C "$main" worktree add -b "$branch" "$path" "$base" >&2
fi
"$(dirname "$(realpath "$0")")/worktree-copy-files" "$path"

printf '%s\n' "$path"
